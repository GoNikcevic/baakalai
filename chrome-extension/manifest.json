{
  "manifest_version": 3,
  "name": "baakalai, LinkedIn Connect",
  "version": "1.1.0",
  "description": "Connectez votre session LinkedIn à baakalai en un clic pour relancer vos clients existants. La connexion se maintient toute seule.",
  "permissions": ["cookies", "storage", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://app.baakal.ai/*",
    "https://baakal-staging.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
