#!/usr/bin/env bash
# Versioned pre-commit hook. Enabled via: git config core.hooksPath .githooks
# (run scripts/install-hooks.sh once per clone). Bypass with: git commit --no-verify
ROOT="$(git rev-parse --show-toplevel)"

# 1. Parité i18n : une clé doit exister dans fr.json ET en.json (règle 1).
node "$ROOT/scripts/check-i18n-parity.js" --quiet

# 2. Audit des patterns.
exec node "$ROOT/scripts/pre-commit-audit.js"
